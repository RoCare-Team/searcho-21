# Public site origin, used for canonical URLs, OpenGraph and sitemaps.
NEXT_PUBLIC_SITE_URL=https://www.searcho21.com

# ---------------------------------------------------------------------------
# Live database (optional)
# ---------------------------------------------------------------------------
# Set these and every page reads the real Searcho21 tables — localities,
# categories, listings, gallery, keywords and the per-URL SEO copy. Leave them
# empty and the app serves the sample rows in src/data instead, so it still runs
# without database access. The frontend only ever reads; it never writes or
# migrates.
SEARCHO21_DB_HOST=
SEARCHO21_DB_PORT=3306
SEARCHO21_DB_USER=
SEARCHO21_DB_PASSWORD=
SEARCHO21_DB_NAME=

# Where uploaded images are served from (logo_img, banner_image, gallery_image,
# category, img_category, img_city, templates, brand_image, others).
# Empty uses the copies in public/; in production point it at the server that
# already hosts them so the images do not ship with the build:
#   NEXT_PUBLIC_ASSET_BASE_URL=https://www.searcho21.com
NEXT_PUBLIC_ASSET_BASE_URL=

# The `uploads/` media library, when it is not on the same origin as `assets/`.
# www.searcho21.com serves assets/ but has no uploads/ at its web root, so with
# NEXT_PUBLIC_ASSET_BASE_URL pointed there this must be set empty to keep serving
# the library from public/uploads. Leave the line out entirely and it follows
# NEXT_PUBLIC_ASSET_BASE_URL, which is right when one origin hosts both roots.
NEXT_PUBLIC_UPLOADS_BASE_URL=
